# ==========================================
# Agile Project Management Tool - Environment
# ==========================================

# Application Settings
PROJECT_NAME="Agile Project Management Tool"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (SQLite persistent path)
DATABASE_URL="sqlite:///./app.db"

# Security & Authentication
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (JSON array of strings)
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]'

# Background Queue & Worker Settings
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_LOCK_TIMEOUT_SECONDS=300
WORKER_MAX_RETRIES=3
WORKER_BASE_BACKOFF_SECONDS=2.0

# Rate Limiting
AUTH_RATE_LIMIT_MAX_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
